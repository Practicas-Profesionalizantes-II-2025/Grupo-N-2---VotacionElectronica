@model List<MVCProyecto.Models.Eleccion.VerDTO>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styleEleccionesVoto.css" asp-append-version="true" />
    <script src="~/js/scriptElecciones.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Elecciones</title>
</head>
<body>
    <div class="container-elecciones">
        <h1>Seleccione una Elección</h1>

        @if (!Model.Any())
        {
            <div class="alerta-info">
                <i class="fa-solid fa-circle-info"></i> Ya votó todo lo que podía.
            </div>
        }
        else
        {
            <div class="elecciones-grid">
                @foreach (var eleccion in Model)
                {
                    var ahora = DateTime.Now;
                    bool noIniciada = eleccion.FechaInicioEleccion.HasValue && eleccion.FechaInicioEleccion > ahora;
                    bool finalizada = eleccion.FechaFinEleccion.HasValue && eleccion.FechaFinEleccion < ahora;

                    <div class="eleccion-card">
                        <h2>@eleccion.NombreEleccion</h2>
                        <p>@eleccion.DescripcionEleccion</p>

                        @if (noIniciada)
                        {
                            <button class="btn btn-secondary" disabled>
                                <i class="fa-solid fa-clock"></i> Aún no comienza
                            </button>
                        }
                        else if (finalizada)
                        {
                            <button class="btn btn-danger" disabled>
                                <i class="fa-solid fa-flag-checkered"></i> Finalizada
                            </button>
                        }
                        else
                        {
                            <a asp-action="Listas"
                               asp-route-eleccionId="@eleccion.Id"
                               class="btn btn-success">
                                <i class="fa-solid fa-door-open"></i> Entrar
                            </a>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
