@model IEnumerable<MVCProyecto.Models.Lista.VerDTO>
@{
    ViewBag.Title = "Listas disponibles";
    var eleccionId = ViewBag.EleccionId;
    var listaBlanco = Model.FirstOrDefault(l => l.NombreLista == "Voto en Blanco");
}

<h2>Listas de la elección</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lista in Model.Where(l => l.NombreLista != "Voto en Blanco"))
        {
            <tr>
                <td>@lista.NombreLista</td>
                <td>@lista.DescripcionLista</td>
                <td>
                    <!-- Botón que abre el modal -->
                    <button class="btn btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#candidatosModal"
                            data-id="@lista.Id">
                        Ver Candidatos
                    </button>

                    <form asp-controller="Votos" asp-action="Registrar" method="post" class="d-inline">
                        <input type="hidden" name="eleccionId" value="@eleccionId" />
                        <input type="hidden" name="listaId" value="@lista.Id" />
                        <button type="submit" class="btn btn-success">Votar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (listaBlanco != null)
{
    <form asp-controller="Votos" asp-action="Registrar" method="post">
        <input type="hidden" name="eleccionId" value="@eleccionId" />
        <input type="hidden" name="listaId" value="@listaBlanco.Id" />
        <button type="submit" class="btn btn-secondary">Votar en blanco</button>
    </form>
}

<!-- Modal: Ver Candidatos -->
<div class="modal fade" id="candidatosModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Candidatos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="candidatosContent">
                Cargando...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalCandidatos = document.getElementById('candidatosModal');

        modalCandidatos.addEventListener('show.bs.modal', async function (event) {
            const button = event.relatedTarget;
            const listaId = button.getAttribute('data-id');

            const content = document.getElementById('candidatosContent');
            content.innerHTML = "Cargando...";

            try {
                const response = await fetch(`/Candidatos/PorLista/${listaId}`);
                if (!response.ok) throw new Error("Error al cargar candidatos");

                const data = await response.json();
                if (data && data.length > 0) {
                    let html = "<ul class='list-group'>";
                    data.forEach(c => {
                        html += `
                          <li class='list-group-item'>
                            <strong>${c.puestoCandidato} </strong> - ${c.nombreCandidato}
                          </li>`;
                    });
                    html += "</ul>";
                    content.innerHTML = html;
                } else {
                    content.innerHTML = "<p>No hay candidatos para esta lista.</p>";
                }
            } catch (err) {
                content.innerHTML = "<p class='text-danger'>Error al cargar los candidatos.</p>";
            }
        });
    </script>
}
