@{
    ViewBag.Title = "Confirmación de Voto";
}

<div class="text-center mt-5">
    <h2 class="text-success">¡Voto registrado con éxito!</h2>
    <p class="mt-3">Tu participación ha sido registrada correctamente.</p>

    <a asp-controller="Votos" asp-action="Emitir" class="btn btn-primary mt-4">
        Volver a Elecciones
    </a>

    <a asp-controller="Resultado" asp-action="Index" class="btn btn-success mt-4 ms-2">
        Ver Resultados
    </a>
</div>
