@{
    ViewBag.Title = "Confirmación de Voto";
    var eleccionId = TempData["EleccionId"];
    var eleccionNombre = TempData["EleccionNombre"] ?? "Resultados";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styleEleccionesVoto.css" asp-append-version="true" />}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scriptVotoListo.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="container-fin text-center mt-5">
        <h1 class="text-success"><i class="fa-solid fa-circle-check"></i> ¡Voto registrado con éxito!</h1>
        <p class="mt-3">Tu participación ha sido registrada correctamente.</p>

        <div class="acciones mt-4">
            <a asp-controller="Votos" asp-action="Emitir" class="btn btn-primary me-2">
                <i class="fa-solid fa-arrow-left"></i> Volver a Elecciones
            </a>

            @if (eleccionId != null)
            {
                <button class="btn btn-success ms-2"
                        data-bs-toggle="modal"
                        data-bs-target="#resultadoModal"
                        data-id="@eleccionId"
                        data-nombre="@eleccionNombre">
                    <i class="fa-solid fa-chart-bar"></i> Ver Resultados
                </button>
            }
        </div>
    </div>    
</body>
</html>

<!-- Modal Resultados -->
<div class="modal fade" id="resultadoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Resultados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <canvas id="resultadoChart"></canvas>
                <hr />
            </div>
        </div>
    </div>
</div>

