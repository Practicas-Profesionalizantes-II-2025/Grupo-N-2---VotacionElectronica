<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCProyecto</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVCProyecto.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo VE.png" alt="MVCProyecto" style="height:60px; margin-right:10px;">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var rol = Context.Session.GetString("Rol");
                    }
                    <ul class="navbar-nav flex-grow-1">
                        @if (currentController == "Home" && currentAction == "Index")
                        {
                            <!-- En Home/Index no mostramos nada -->
                        }
                        else
                        {
                            if (rol == "Administrador" || rol == "SuperAdmin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Persona" asp-action="ListaPersonas">Personas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Lista" asp-action="ListaLista">Listas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Candidatos" asp-action="ListaCandidatos">Candidatos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Eleccion" asp-action="ListaEleccion">Elecciones</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Resultado" asp-action="Index">Resultados</a>
                                </li>
                            }
                            else if (rol == "Votante")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Votos" asp-action="Emitir">Voto</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Resultado" asp-action="Index">Resultados</a>
                                </li>
                            }
                        }
                    </ul>


                    <div class="d-flex align-items-center">
                        @if (Context.Session.GetString("Usuario") != null)
                        {
                            <div class="user-box me-3">
                                Bienvenido, @Context.Session.GetString("Usuario")
                            </div>
                        }

                        <!-- Botón de cerrar sesión -->
                        <a class="nav-link text-dark" href="#" data-bs-toggle="modal" data-bs-target="#confirmLogoutModal">
                            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                        </a>
                    </div>

                </div>


                <!-- Modal -->
                <div class="modal fade" id="confirmLogoutModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content">
                            <div class="modal-body text-center">
                                <p>¿Está seguro que desea cerrar sesión?</p>
                                <a asp-controller="Account" asp-action="Logout" class="btn btn-primary">Confirmar</a>
                                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
                                    
                            </div>
                        </div>
                    </div>
                </div>

                </div>

            </div>
        </nav>
    </header>
  
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white text-dark py-3 mt-auto">
        <div class="container text-center">
            &copy; 2025 - Votación Electrónica
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
