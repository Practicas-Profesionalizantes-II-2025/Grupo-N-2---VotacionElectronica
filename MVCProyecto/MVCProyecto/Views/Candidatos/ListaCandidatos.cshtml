@model IEnumerable<MVCProyecto.Models.Candidatos.VerDTO>

<h1>Listado de Candidatos</h1>

<p>
    <a asp-action="CrearCandidato">➕ Crear Nuevo Candidato</a>
</p>

<form asp-action="BuscarPorNombre" method="post" class="mb-3">
    <input type="text" name="nombre" placeholder="Buscar por nombre" />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Puesto</th>
            <th>Id Lista</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.NombreCandidato</td>
                <td>@c.PuestoCandidato</td>
                <td>@c.IdLista</td>
                <td>
                    <a asp-action="BuscarPorId" asp-route-id="@c.Id">🔍 Ver</a> |
                    <a asp-action="EditarCandidato" asp-route-id="@c.Id">✏ Editar</a> |
                    <a asp-action="EliminarCandidato" asp-route-id="@c.Id">🗑 Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
