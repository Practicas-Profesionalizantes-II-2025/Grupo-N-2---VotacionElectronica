@model MVCProyecto.Models.Candidatos.ModificarDTO

<h2>Editar Candidato</h2>

<form asp-action="EditarCandidato" method="post">
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="NombreCandidato" class="form-control" />
    </div>
    <div class="form-group">
        <label>Puesto</label>
        <input asp-for="PuestoCandidato" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar Cambios</button>
</form>
