
@model MVCProyecto.Models.Candidatos.VerDTO

<h1>Eliminar Candidato</h1>

<div>
    <p>¿Está seguro que desea eliminar a <strong>@Model.NombreCandidato @Model.PuestoCandidato</strong>?</p>
</div>

<form asp-action="EliminarCandidato" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="ListaCandidatos" class="btn btn-secondary">Cancelar</a>
</form>
