@model MVCProyecto.Models.Candidatos.VerDTO

<h2>Eliminar Candidato</h2>

<div>
    <h3>¿Seguro que desea eliminar al candidato <b>@Model.NombreCandidato</b>?</h3>
    <form asp-action="EliminarConfirmado" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="ListaCandidatos" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
