@model MVCProyecto.Models.Candidatos.CrearDTO

<h2>Crear Candidato</h2>

<form asp-action="CrearCandidato" method="post">
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="NombreCandidato" class="form-control" />
    </div>
    <div class="form-group">
        <label>Puesto</label>
        <input asp-for="PuestoCandidato" class="form-control" />
    </div>
    <div class="form-group">
        <label>Id Lista</label>
        <input asp-for="IdLista" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
</form>
