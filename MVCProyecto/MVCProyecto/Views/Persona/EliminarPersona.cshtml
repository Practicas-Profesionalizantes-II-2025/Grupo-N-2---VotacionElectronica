@model MVCProyecto.Models.Persona.VerDTO

<h1>Eliminar Persona</h1>

<div>
    <p>¿Está seguro que desea eliminar a <strong>@Model.NombrePersona @Model.ApellidoPersona</strong>?</p>
</div>

<form asp-action="EliminarConfirmado" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Eliminar</button>
    <a asp-action="ListaPersonas">Cancelar</a>
</form>
