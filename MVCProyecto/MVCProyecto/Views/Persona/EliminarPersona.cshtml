@model MVCProyecto.Models.Persona.VerDTO

<h1>Eliminar Persona</h1>

<div>
    <p>¿Está seguro que desea eliminar a <strong>@Model.NombrePersona @Model.ApellidoPersona</strong>?</p>
</div>

<form asp-action="EliminarPersona" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="ListaPersonas" class="btn btn-secondary">Cancelar</a>
</form>

