@model MVCProyecto.Models.Persona.ModificarDTO
@{
    Layout = null; 
}

<div class="form-container">
    <h1 class="text-center"">Editar Persona</h1>

    <form asp-action="EditarPersona" method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="NombrePersona">Nombre</label>
                    <input asp-for="NombrePersona" class="form-control" />
                    <span asp-validation-for="NombrePersona" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="ApellidoPersona">Apellido</label>
                    <input asp-for="ApellidoPersona" class="form-control" />
                    <span asp-validation-for="ApellidoPersona" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="ContraseniaPersona">Contraseña</label>
                    <input asp-for="ContraseniaPersona" type="password" class="form-control" />
                    <span asp-validation-for="ContraseniaPersona" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions text-center mt-3">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

