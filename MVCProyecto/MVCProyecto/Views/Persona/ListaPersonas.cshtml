@model IEnumerable<MVCProyecto.Models.Persona.VerDTO>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styleListas.css" asp-append-version="true" />
    <script src="~/js/scriptLista.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Persona</title>
</head>
<body>
    <div class="table">
        <div class="table_header">
            <h1>Listado de personas</h1>
            <div class="buscar-registrar">
                <div class="buscar">
                    <input id="buscarPersona" placeholder="Buscar persona">
                    <button id="btnBuscar" type="button" class="button btn-sm">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
                <div class="registrar">
                    <button type="button" class="registrarPersona"
                            data-bs-toggle="modal" data-bs-target="#personaModal"
                            data-url="@Url.Action("CrearPersona")">
                        Crear persona
                    </button>
                </div>
            </div>
        </div>
        <div class="table_section">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Dni</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Rol</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Dni</td>
                            <td>@p.NombrePersona</td>
                            <td>@p.ApellidoPersona</td>
                            <td>@p.Rol</td>
                            <td>
                                <button type="button" class="btnEditar btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#personaModal"
                                        data-url="@Url.Action("EditarPersona", new { id = p.Id })">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>

                                <button type="button" class="btnEliminar btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#personaModal"
                                        data-url="@Url.Action("EliminarPersona", new { id = p.Id })">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="personaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-body">
                    <div id="personaModalContent"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Cargar el contenido del modal dinámicamente (pero sin AJAX POST todavía)
        var personaModal = document.getElementById('personaModal');
        personaModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var url = button.getAttribute('data-url');
            var modalContent = document.getElementById('personaModalContent');

            fetch(url)
                .then(response => response.text())
                .then(html => modalContent.innerHTML = html);
        });
    </script>
</body>
</html>
