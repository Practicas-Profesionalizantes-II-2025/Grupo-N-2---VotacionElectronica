@{
    ViewBag.Title = "Cambiar Contraseña";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styleCambiarContrasenia.css" asp-append-version="true" />
    <title>Cambiar Contraseña</title>
</head>
<body>
    <div class="contenido">
        <div class="container-cambiar">
            <h2>Cambiar Contraseña</h2>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form asp-action="CambiarContrasenia" method="post">
                <div class="mb-3 text-start">
                    <label for="nuevaContrasenia" class="form-label">Nueva Contraseña</label>
                    <input type="password" class="form-control" id="nuevaContrasenia" name="nuevaContrasenia" required />
                </div>
                <button type="submit" class="btn btn-success w-100">Guardar</button>
            </form>
        </div>
    </div>

</body>
</html>