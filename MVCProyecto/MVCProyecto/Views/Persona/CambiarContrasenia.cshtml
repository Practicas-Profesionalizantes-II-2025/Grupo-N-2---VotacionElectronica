@{
    ViewBag.Title = "Cambiar Contraseña";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styleCambiarContrasenia.css" asp-append-version="true" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script src="~/js/scriptLogin.js"></script>
    <title>Cambiar Contraseña</title>
</head>
<body>
    <div class="contenido">
        <div class="container-cambiar">
            <h2>Cambiar Contraseña</h2>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="CambiarContrasenia" method="post">
                <div class="mb-3 text-start">
                    <label for="passwordInput" class="form-label">Nueva Contraseña</label>
                    <div class="input-wrapper">
                        <input type="password" class="form-control" id="passwordInput" name="nuevaContrasenia" placeholder="Contraseña" required />
                        <ion-icon id="togglePassword" class="password-icon" name="eye-outline"></ion-icon>
                    </div>
                </div>
                <button type="submit" class="btn btn-success w-100">Guardar</button>
            </form>
        </div>
    </div>
</body>
</html>
