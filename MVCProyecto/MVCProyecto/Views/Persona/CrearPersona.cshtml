@model MVCProyecto.Models.Persona.CrearDTO
@{
    Layout = null;
}

<div class="form-container">
    <h1 class="text-center">Crear nueva persona</h1>

    <form asp-action="CrearPersona" method="post">
       <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="NombrePersona">Nombre</label>
                    <input asp-for="NombrePersona" class="form-control" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="ApellidoPersona">Apellido</label>
                    <input asp-for="ApellidoPersona" class="form-control" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="NroIdentificacionPersona">Número de Identificación</label>
                    <input asp-for="NroIdentificacionPersona" class="form-control" />
                </div>
            </div>
   

            <div class="col-md-6">
                <div class="form-group">
                    <label for="TipoDocumentoPersona">Tipo de documento</label>
                    <input asp-for="TipoDocumentoPersona" class="form-control" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="Rol">Rol</label>
                    <select asp-for="Rol" class="form-control">
                        <option value="Votante">Votante</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                </div>
            </div>

        </div>

        <div class="form-actions text-center mt-3">
            <button type="submit" class="btn btn-success">Guardar</button>
            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}