@model MVCProyecto.Models.Persona.CrearDTO
@{
    Layout = null; 
}

<div class="form-container">
    <h1>Crear Persona</h1>

    <form asp-action="CrearPersona" method="post">
        <div class="form-group">
            <label asp-for="NroIdentificacionPersona"></label>
            <input asp-for="NroIdentificacionPersona" class="form-control" />
            <span asp-validation-for="NroIdentificacionPersona" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NombrePersona"></label>
            <input asp-for="NombrePersona" class="form-control" />
            <span asp-validation-for="NombrePersona" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ApellidoPersona"></label>
            <input asp-for="ApellidoPersona" class="form-control" />
            <span asp-validation-for="ApellidoPersona" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ContraseniaPersona"></label>
            <input asp-for="ContraseniaPersona" type="password" class="form-control" />
            <span asp-validation-for="ContraseniaPersona" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="TipoDocumentoPersona"></label>
            <input asp-for="TipoDocumentoPersona" class="form-control" />
            <span asp-validation-for="TipoDocumentoPersona" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Rol"></label>
            <input asp-for="Rol" class="form-control" />
            <span asp-validation-for="Rol" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success">Guardar</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
