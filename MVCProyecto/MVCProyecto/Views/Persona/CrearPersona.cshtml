@model MVCProyecto.Models.Persona.CrearDTO

<h1>Crear Persona</h1>

<form asp-action="CrearPersona" method="post">
    <div>
        <label asp-for="NroIdentificacionPersona"></label>
        <input asp-for="NroIdentificacionPersona" />
        <span asp-validation-for="NroIdentificacionPersona"></span>
    </div>

    <div>
        <label asp-for="NombrePersona"></label>
        <input asp-for="NombrePersona" />
        <span asp-validation-for="NombrePersona"></span>
    </div>

    <div>
        <label asp-for="ApellidoPersona"></label>
        <input asp-for="ApellidoPersona" />
        <span asp-validation-for="ApellidoPersona"></span>
    </div>

    <div>
        <label asp-for="ContraseniaPersona"></label>
        <input asp-for="ContraseniaPersona" type="password" />
        <span asp-validation-for="ContraseniaPersona"></span>
    </div>

    <div>
        <label asp-for="TipoDocumentoPersona"></label>
        <input asp-for="TipoDocumentoPersona" />
        <span asp-validation-for="TipoDocumentoPersona"></span>
    </div>

    <div>
        <label asp-for="Rol"></label>
        <input asp-for="Rol" />
        <span asp-validation-for="Rol"></span>
    </div>

    <button type="submit">Guardar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
