@model IEnumerable<MVCProyecto.Models.Eleccion.VerDTO>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styleResultados.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/scriptLista.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Resultados</title>
</head>
<body>
    <div class="table">
        <div class="table_header">
            <h1>Resultados de Elecciones</h1>
        </div>

        <div class="table_section">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No hay elecciones para mostrar.
                </div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var eleccion in Model)
                        {
                            <tr>
                                <td>@eleccion.NombreEleccion</td>
                                <td>@eleccion.DescripcionEleccion</td>
                                <td>
                                    <button class="btn btn-primary btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#resultadoModal"
                                            data-id="@eleccion.Id"
                                            data-nombre="@eleccion.NombreEleccion">
                                        Ver resultados
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="resultadoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Resultados</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <canvas id="resultadoChart"></canvas>
                    <hr />
                </div>
            </div>
        </div>
    </div>
</body>
</html>
