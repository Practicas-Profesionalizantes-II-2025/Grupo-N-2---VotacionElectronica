@model IEnumerable<MVCProyecto.Models.Eleccion.VerDTO>

<!-- Token global para formularios dinámicos -->
<form id="__afForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/styleListas.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scriptLista.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Elección</title>
</head>
<body>
    <div class="table">
        <div class="table_header">
            <h1>Listado de elecciones</h1>
            <div class="buscar-registrar">
                <div class="buscar">
                    <input id="busqueda" placeholder="Buscar elección">
                    <button id="btnBuscar" type="button" class="button btn-sm">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
                <div class="registrar">
                    <button type="button" class="registrarPersona"
                            data-bs-toggle="modal" data-bs-target="#ModalLista"
                            data-url="@Url.Action("CrearEleccion")">
                        Crear elección
                    </button>
                </div>
            </div>
        </div>
        <div class="table_section">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Cantidad Listas</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td style="width: 10px; text-align: center;">@e.Id</td>
                            <td>@e.NombreEleccion</td>
                            <td>@e.DescripcionEleccion</td>
                            <td>
                                @e.CantidadListas
                                <button class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalVerListas"
                                        data-id="@e.Id">
                                    👁
                                </button>
                            </td>
                            <td>@e.FechaInicioEleccion</td>
                            <td>@e.FechaFinEleccion</td>
                            <td style="width: 150px">
                                <button type="button" class="btnVer btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#ModalLista"
                                        data-url="@Url.Action("VerEleccion", new { id = e.Id })">
                                    <i class="fa-solid fa-eye"></i>
                                </button>

                                <button type="button" class="btnEditar btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#ModalLista"
                                        data-url="@Url.Action("ModificarEleccion", new { id = e.Id })">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>

                                <button type="button" class="btnEliminar btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#ModalLista"
                                        data-url="@Url.Action("EliminarEleccion", new { id = e.Id })">
                                    <i class="fa-solid fa-trash"></i>
                                </button>

                                <button type="button" class="btnALista btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalAsignarLista"
                                        data-id="@e.Id">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                                <button type="button" class="btnAPersona btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalAsignarPersona"
                                        data-id="@e.Id">
                                    <i class="fa-solid fa-user-plus"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="ModalLista" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-body">
                    <div id="ModalListaContent"></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<!-- Modal: Asignar Lista -->
<div class="modal fade" id="modalAsignarLista" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Asignar Lista</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formAsignarLista" asp-action="AsignarListaEleccion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="EleccionIdLista" name="EleccionId" />
                    <div class="mb-3">
                        <label for="ListaId" class="form-label">Lista</label>
                        <select id="ListaId" name="ListaId" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="Descripcion" class="form-label">Descripción</label>
                        <input id="Descripcion" name="Descripcion" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Asignar</button>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Modal: Ver Listas Asignadas -->
<div class="modal fade" id="modalVerListas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Listas Asignadas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID Lista</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Quitar</th>
                        </tr>
                    </thead>
                    <tbody id="listasAsignadasBody">
                        <!-- dinámico -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Asignar Persona -->
<div class="modal fade" id="modalAsignarPersona" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Asignar Persona</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formAsignarPersona" asp-action="AsignarPersonaEleccion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="EleccionIdPersona" name="EleccionId" />
                    <div class="mb-3">
                        <label for="PersonaId" class="form-label">Persona</label>
                        <select id="PersonaId" name="PersonaId" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Asignar</button>
                </form>
            </div>
        </div>
    </div>
</div>



