@model MVCProyecto.Models.Eleccion.ModificarDTO

<h2>Editar Elección</h2>

<form asp-action="ModificarEleccion" method="post">
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="NombreEleccion" class="form-control" />
    </div>
    <div class="form-group">
        <label>Descripción</label>
        <input asp-for="DescripcionEleccion" class="form-control" />
    </div>
    <div class="form-group">
        <label>Cantidad Listas</label>
        <input asp-for="CantidadListas" class="form-control" type="number" />
    </div>
    <div class="form-group">
        <label>Fecha Inicio</label>
        <input asp-for="FechaInicioEleccion" class="form-control" type="date" />
    </div>
    <div class="form-group">
        <label>Fecha Fin</label>
        <input asp-for="FechaFinEleccion" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="ListaEleccion" class="btn btn-secondary">Cancelar</a>
</form>
