@model MVCProyecto.Models.Eleccion.CrearDTO

@{
    Layout = null;
}

<div class="form-container">
    <h1 class="text-center">Crear nueva elección</h1>

    <form asp-action="CrearEleccion" method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="NombreEleccion">Nombre</label>
                    <input asp-for="NombreEleccion" class="form-control" />
                    <span asp-validation-for="NombreEleccion" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="DescripcionEleccion">Descripción</label>
                    <input asp-for="DescripcionEleccion" class="form-control" />
                    <span asp-validation-for="DescripcionEleccion" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="CantidadListas">Cantidad listas</label>
                    <input asp-for="CantidadListas" class="form-control" type="number" />
                    <span asp-validation-for="CantidadListas" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="FechaInicio">Fecha inicio</label>
                    <input asp-for="FechaInicioEleccion" class="form-control" type="date" />
                    <span asp-validation-for="FechaInicioEleccion" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label for="FechaFin">Fecha fin</label>
                    <input asp-for="FechaFinEleccion" class="form-control" type="date" />
                    <span asp-validation-for="FechaFinEleccion" class="text-danger"></span>
                </div>
            </div>

        </div>

        <div class="form-actions text-center mt-3">
            <button type="submit" class="btn btn-success">Guardar</button>
            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}