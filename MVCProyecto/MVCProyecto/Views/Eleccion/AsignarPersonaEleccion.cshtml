@model MVCProyecto.Models.Eleccion.AsignarPersonaEleccionDTO

<h2>Asignar Persona a Elección</h2>

<form asp-action="AsignarPersonaEleccion" method="post">
    <input type="hidden" asp-for="EleccionId" />

    <div class="form-group">
        <label>Id de la Persona</label>
        <input asp-for="PersonaId" class="form-control" type="number" />
        <span asp-validation-for="PersonaId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Asignar</button>
    <a asp-action="VerEleccion" asp-route-id="@Model.EleccionId" class="btn btn-secondary">Cancelar</a>
</form>
