@model MVCProyecto.Models.Eleccion.VerDTO
@{
    Layout = null;
}


<h2>Detalles de la Elección</h2>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.NombreEleccion</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.DescripcionEleccion</dd>

    <dt class="col-sm-2">Cantidad Listas</dt>
    <dd class="col-sm-10">@Model.CantidadListas</dd>

    <dt class="col-sm-2">Fecha Inicio</dt>
    <dd class="col-sm-10">@Model.FechaInicioEleccion</dd>

    <dt class="col-sm-2">Fecha Fin</dt>
    <dd class="col-sm-10">@Model.FechaFinEleccion</dd>
</dl>


<a asp-action="ListaEleccion" class="btn btn-secondary">⬅ Volver</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}